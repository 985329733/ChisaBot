# /opt/chisabot-updater/config.env（install.sh 首次安装时复制，之后不会覆盖；按自己的部署修改）
COMPOSE_DIR=/opt/openbot-zh
COMPOSE_FILE=compose.yaml
PROJECT=openbot-zh
SERVICE=openbot
CONTAINER=openbot-zh
IMAGE_REPO=local/chisabot
# 压平的底座（只有 1 层）；依赖变了要先手动构建新底座再改这里和 base-deps.sha256。
BASE_IMAGE=local/chisabot:flat-base
NODE_MODULES_BASE=/opt/chisabot-updater/node_modules-base
# 构建期间暂停的容器（空格分隔，可留空），结束后恢复；小内存机器上用来腾内存。
PROTO_CONTAINERS=""
BUILD_MEMORY=3500m
LOCAL_URL=http://127.0.0.1:3001
# 公网登录页（与 deploy/.env 的 CHISABOT_DOMAIN / CHISABOT_HTTPS_PORT 一致）。
PUBLIC_HEALTH_URL=https://chisabot.example.com:8443/login
VITE_MAGPIE_MANAGEMENT_URL=
# 拉取新提交的仓库（自己的 fork 就改成自己的 owner/repo）。
GITHUB_REPO=ChisaAlter/ChisaBot
GITHUB_BRANCH=main
KEEP_IMAGES=3
KEEP_BACKUPS=5
