# /opt/chisabot-updater/config.env（install.sh 复制；按部署修改）
COMPOSE_DIR=/opt/openbot-zh
COMPOSE_FILE=compose.yaml
PROJECT=openbot-zh
SERVICE=openbot
CONTAINER=openbot-zh
IMAGE_REPO=local/chisabot
# 压平的底座（只有 1 层）；依赖变了要先手动构建新底座再改这里和 base-deps.sha256。
BASE_IMAGE=local/chisabot:flat-20261011b
NODE_MODULES_BASE=/opt/chisabot-updater/node_modules-base
# 构建期间暂停的容器（原型沙箱），结束后恢复。
PROTO_CONTAINERS="chisabot-proto"
BUILD_MEMORY=3500m
LOCAL_URL=http://127.0.0.1:3001
PUBLIC_HEALTH_URL=https://ayase.cn:8443/login
VITE_MAGPIE_MANAGEMENT_URL=https://ayase.cn:2053/
GITHUB_REPO=ChisaAlter/ChisaBot
GITHUB_BRANCH=main
KEEP_IMAGES=3
KEEP_BACKUPS=5
